<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/guide_step_back_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:background="@android:color/transparent"
            android:src="@drawable/back2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/guide_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/guide_step_back_btn"
            app:layout_constraintBottom_toTopOf="@id/guide_indicator" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/guide_indicator"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:color/transparent"

            app:tabBackground="@drawable/selector_dot"
            app:tabIndicatorHeight="0dp"
            app:tabRippleColor="@android:color/transparent"

            app:tabMaxWidth="4dp"
            app:tabMinWidth="4dp"
            app:tabPaddingStart="4dp"
            app:tabPaddingEnd="4dp"
            app:tabMode="fixed"
            app:tabGravity="center"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/api_key_input_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API KEY 입력"
            android:textSize="12sp"
            android:padding="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/active"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>