<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/guide_step_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/pretendard_semibold"
                android:text="01"
                android:textColor="@color/active"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/guide_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/pretendard_semibold"
                android:text="거래소 API 페이지 접속"
                android:textColor="@color/main_black"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/guide_step_number" />

            <LinearLayout
                android:id="@+id/exchange_tab_layout"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/guide_title_tv">

                <androidx.cardview.widget.CardView
                    android:id="@+id/bithumb_tab_cv"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/active_fill"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/guide_bithumb_tv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="빗썸"
                        android:textColor="@color/active"
                        android:textSize="13sp" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/upbit_tab_cv"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/guide_upbit_tv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="업비트"
                        android:textColor="@color/disabled"
                        android:textSize="13sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/guide_image_container"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="15dp"
                app:cardBackgroundColor="@color/disabled_fill"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gray300"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/exchange_tab_layout">

                <pl.droidsonroids.gif.GifImageView
                    android:id="@+id/guide_image_iv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bithumb_1" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/guide_text_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/pretendard_regular"
                android:lineSpacingExtra="6sp"
                android:paddingHorizontal="16dp"
                android:text="거래소 앱 또는 웹사이트에 접속하여\nAPI 관리 메뉴를 찾아주세요."
                android:textColor="@color/main_black"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/guide_image_container" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/guide_ip_box_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_guide_notice"
                android:padding="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/guide_text_tv">

                <TextView
                    android:id="@+id/guide_ip_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13.209.12.10"
                    android:textSize="16sp"
                    android:textColor="@color/main_black"
                    android:fontFamily="@font/pretendard_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/guide_ip_copy_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/copy_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/guide_ip_tv"
                    app:layout_constraintBottom_toBottomOf="@id/guide_ip_tv"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="* 해당 주소는 스코이 서버 IP 주소로, 서비스 이용을 위해 등록이 필요합니다."
                    android:textColor="@color/sub_gray_1"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/guide_ip_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/guide_notice_cv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/disabled_fill"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp"
                app:contentPadding="10dp"
                app:layout_constraintTop_toBottomOf="@id/guide_ip_box_layout">

                <TextView
                    android:id="@+id/guide_explain_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_regular"
                    android:text="* API 설정은 보안상 PC 웹 환경에서만 가능합니다."
                    android:textColor="@color/disabled"
                    android:textSize="12sp" />
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>